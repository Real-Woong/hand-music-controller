cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
env/

# macOS
.DS_Store

# IDE
.vscode/
.idea/

# Jupyter
.ipynb_checkpoints/

# Logs
*.log

# Environment
.env

# Media / output
*.mp4
*.mov
*.avi

# Model / cache
*.h5
*.pt
*.pth
EOF

# 프로젝트 상태 관리 파일 (로컬 전용)
_STATUS.md
